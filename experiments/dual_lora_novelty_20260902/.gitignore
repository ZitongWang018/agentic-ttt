# Generated scheduler logs and run directories. Selected result snapshots are
# force-added explicitly, matching the repository's other experiment folders.
logs/*
pilot/*
formal/*
summary/*
relative_formal/*
f2p_checkpoint_rerun/*

# Large resumable environment snapshots and LoRA checkpoints stay local.
**/config.jsonl
**/memory/
**/lora_checkpoints/
**/*.safetensors
**/*.pt
**/*.pth
**/*.ckpt
**/__pycache__/
*.pyc

# Cluster-local downloaded dependencies.
vendor/

!logs/.gitkeep
!logs/completed_*.log
!pilot/.gitkeep
!formal/.gitkeep
!summary/.gitkeep
!summary/*.json
!summary/*.csv
!summary/*.tsv
!summary/*.md
!summary/*.png
!summary/*.pdf
!summary/*.svg
